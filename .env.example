# Copia este archivo como .env.local (que Git ignora) y completa los valores.
#
# IMPORTANTE: todo lo que empieza con VITE_ queda visible para cualquiera dentro del sitio.
# Solo van aquí valores públicos por diseño. La compilación se detiene si detecta un secreto.
#
# Supabase (etapa B): la "anon key" es pública y está protegida por las políticas RLS de la base de datos.
# NUNCA pongas aquí la "service_role key": esa solo vive en el servidor.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Medición con PostHog: llave pública del proyecto (empieza con phc_). Vacía = sin medición.
# En Cloudflare Pages se configura en: proyecto → Configuración → Variables y secretos (como texto, no como secreto).
VITE_POSTHOG_KEY=
# Servidor de PostHog: Europa (recomendado) o Estados Unidos
VITE_POSTHOG_HOST=https://eu.i.posthog.com
